# Dockerfile.frontend
# Multi-stage build: base (dev/test) → build (compile) → prod (serve)

# ── Stage 1: base ──────────────────────────────────────────────────
# Used by dev/test compose via "target: base" with volume-mounted source
ARG NODE_IMAGE=node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
FROM ${NODE_IMAGE} AS base

WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps

EXPOSE 3001

CMD ["npm", "start"]

# ── Stage 2: build ─────────────────────────────────────────────────
FROM base AS build

COPY public/ ./public/
COPY src/ ./src/
COPY tsconfig.json ./

ENV CI=false
ENV GENERATE_SOURCEMAP=false
ENV TSC_COMPILE_ON_ERROR=false
ENV DISABLE_ESLINT_PLUGIN=true

ARG PUBLIC_URL
ARG REACT_APP_WS_URL

RUN PUBLIC_URL=$PUBLIC_URL \
    REACT_APP_API_URL=__REACT_APP_API_URL_PLACEHOLDER__ \
    REACT_APP_WS_URL=$REACT_APP_WS_URL \
    npm run build

# ── Stage 3: prod ──────────────────────────────────────────────────
# Clean image — no source, no node_modules
FROM ${NODE_IMAGE} AS prod

LABEL org.opencontainers.image.source="https://github.com/ttpears/snap-dns"
LABEL org.opencontainers.image.description="Snap DNS - Frontend UI"
LABEL org.opencontainers.image.licenses="MIT"

WORKDIR /app

COPY runtime/frontend/package*.json ./
RUN npm ci --omit=dev
ENV PATH="/app/node_modules/.bin:${PATH}"

COPY --from=build /app/build ./build

RUN echo '{ "rewrites": [{ "source": "**", "destination": "/index.html" }] }' > serve.json

COPY scripts/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 3001

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["serve", "-s", "build", "-l", "3001", "--config", "/app/serve.json"]
